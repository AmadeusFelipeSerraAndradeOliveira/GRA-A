// Assumed data model (Firestore Standard, project graca-454ff):
// products/{id}: public catalog fields only; acquisition costs are isolated in
// productCosts/{id}, readable and writable only by administrators.
// products/{id}: name/category (bounded strings), price/discount (numbers),
//   stock/reservedStock (bounded nonnegative integers), sizes (1-20 values),
//   active/featured/seededExample (booleans), description/color/mark,
//   Cloudinary imageUrl/imagePublicId, and timestamps. Example imports stay
//   inactive until reviewed; only admins write.
// categories/{id}: bounded name, active flag, updatedAt. Active names are public;
//   only admins write.
// orders/{id}: immutable owner UID/contact/items/price/address/consent/createdAt;
//   each request has 1-6 item maps with productId/name/size/quantity/unitPriceCents,
//   a total in cents, delivery method, status history, stock flags, timestamps.
//   Closing a delivered order records salesChannel, paymentMethod, saleTotalCents,
//   installmentCount, installmentValueCents, finalInstallmentValueCents, closedAt.
//   Owner reads own; admins read and transition; no deletes.
// customers/{uid}: UID/email/name/phone/address/marketingConsent and timestamps.
//   Owner reads/updates own; admins read/delete profile documents; email, UID
//   and createdAt are immutable. Deleting a profile does not delete Auth or orders.
// admins/{uid}: authorization marker; no client writes.
// coupons/{id}: code/value/status/timestamps. campaigns/{id}: title/description/
//   status/timestamps. Email-verified, non-anonymous accounts gain VIP access
//   automatically; a verified user may create only their own active vipUsers
//   record, while admins can explicitly block or remove access.
// messages/{id}: UID/name/email/subject/message/status/timestamps; private to admins
//   after creation, with admin-only deletion. Cloudinary preset is public config.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true && (
        request.auth.token.admin == true
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function validSiteResetMarker(data) {
      return isAdmin()
        && data.keys().hasAll(['resetBy', 'createdAt'])
        && data.keys().hasOnly(['resetBy', 'createdAt'])
        && data.resetBy == request.auth.uid
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time >= request.time.toMillis() / 1000 - 300;
    }

    function siteResetAuthorized() {
      let path = /databases/$(database)/documents/settings/siteReset;
      return isAdmin() && exists(path)
        && get(path).data.resetBy == request.auth.uid
        && get(path).data.createdAt is timestamp
        && request.time < get(path).data.createdAt + duration.value(10, 'm');
    }

    function validCloudinaryImageUrl(value) {
      return value is string && value.size() <= 2048
        && value.matches('https://res\\.cloudinary\\.com/imc3dn7g/image/upload/.*');
    }

    function validCloudinaryPublicId(value) {
      return value is string && value.size() > 0 && value.size() <= 255
        && value.matches('^[A-Za-z0-9_-][A-Za-z0-9_/-]*$')
        && !value.matches('.*//.*');
    }

    function validSizeStock(value) {
      return value is int && value >= 0 && value <= 100000;
    }

    function validStockBySize(data) {
      return !('stockBySize' in data)
        || (data.stockBySize is map
          && data.stockBySize.keys().size() == data.sizes.size()
          && data.stockBySize.keys().hasAll(data.sizes)
          && validSizeStock(data.stockBySize[data.sizes[0]])
          && (data.sizes.size() < 2 || validSizeStock(data.stockBySize[data.sizes[1]]))
          && (data.sizes.size() < 3 || validSizeStock(data.stockBySize[data.sizes[2]]))
          && (data.sizes.size() < 4 || validSizeStock(data.stockBySize[data.sizes[3]]))
          && (data.sizes.size() < 5 || validSizeStock(data.stockBySize[data.sizes[4]]))
          && (data.sizes.size() < 6 || validSizeStock(data.stockBySize[data.sizes[5]]))
          && (data.sizes.size() < 7 || validSizeStock(data.stockBySize[data.sizes[6]]))
          && (data.sizes.size() < 8 || validSizeStock(data.stockBySize[data.sizes[7]]))
          && (data.sizes.size() < 9 || validSizeStock(data.stockBySize[data.sizes[8]]))
          && (data.sizes.size() < 10 || validSizeStock(data.stockBySize[data.sizes[9]]))
          && (data.sizes.size() < 11 || validSizeStock(data.stockBySize[data.sizes[10]]))
          && (data.sizes.size() < 12 || validSizeStock(data.stockBySize[data.sizes[11]]))
          && (data.sizes.size() < 13 || validSizeStock(data.stockBySize[data.sizes[12]]))
          && (data.sizes.size() < 14 || validSizeStock(data.stockBySize[data.sizes[13]]))
          && (data.sizes.size() < 15 || validSizeStock(data.stockBySize[data.sizes[14]]))
          && (data.sizes.size() < 16 || validSizeStock(data.stockBySize[data.sizes[15]]))
          && (data.sizes.size() < 17 || validSizeStock(data.stockBySize[data.sizes[16]]))
          && (data.sizes.size() < 18 || validSizeStock(data.stockBySize[data.sizes[17]]))
          && (data.sizes.size() < 19 || validSizeStock(data.stockBySize[data.sizes[18]]))
          && (data.sizes.size() < 20 || validSizeStock(data.stockBySize[data.sizes[19]])));
    }

    function validProduct(data) {
      return data.keys().hasAll(['name', 'category', 'price', 'stock', 'sizes', 'active', 'imageUrl', 'imagePublicId', 'updatedAt'])
        && data.keys().hasOnly(['name', 'category', 'price', 'discount', 'stock', 'stockBySize', 'reservedStock', 'sizes', 'active', 'description', 'featured', 'imageUrl', 'imagePublicId', 'imageGallery', 'color', 'mark', 'seededExample', 'updatedAt', 'createdAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.category is string && data.category.size() > 0 && data.category.size() <= 80
        && data.price is number && data.price > 0 && data.price <= 100000
        && data.stock is int && data.stock >= 0 && data.stock <= 100000
        && (!('reservedStock' in data) || (data.reservedStock is int && data.reservedStock >= 0 && data.reservedStock <= 100000))
        && data.sizes is list && data.sizes.size() > 0 && data.sizes.size() <= 20
        && validStockBySize(data)
        && data.active is bool
        && (!('discount' in data) || (data.discount is number && data.discount >= 0 && data.discount <= 99))
        && (!('description' in data) || (data.description is string && data.description.size() <= 1200))
        && (!('featured' in data) || data.featured is bool)
        && validCloudinaryImageUrl(data.imageUrl)
        && validCloudinaryPublicId(data.imagePublicId)
        && validImageGallery(data)
        && (!('seededExample' in data) || data.seededExample is bool)
        && (!('color' in data) || (data.color is string && data.color.size() <= 40))
        && (!('mark' in data) || (data.mark is string && data.mark.size() <= 80))
        && data.updatedAt is timestamp
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function validGalleryImage(image) {
      return image is map
        && image.keys().hasAll(['imageUrl', 'imagePublicId'])
        && image.keys().hasOnly(['imageUrl', 'imagePublicId'])
        && validCloudinaryImageUrl(image.imageUrl)
        && validCloudinaryPublicId(image.imagePublicId);
    }

    function validImageGallery(data) {
      return !('imageGallery' in data)
        || (data.imageGallery is list && data.imageGallery.size() >= 1 && data.imageGallery.size() <= 5
          && validGalleryImage(data.imageGallery[0])
          && data.imageGallery[0].imageUrl == data.imageUrl
          && data.imageGallery[0].imagePublicId == data.imagePublicId
          && (data.imageGallery.size() < 2 || validGalleryImage(data.imageGallery[1]))
          && (data.imageGallery.size() < 3 || validGalleryImage(data.imageGallery[2]))
          && (data.imageGallery.size() < 4 || validGalleryImage(data.imageGallery[3]))
          && (data.imageGallery.size() < 5 || validGalleryImage(data.imageGallery[4])));
    }

    function validProductCost(data) {
      return data.keys().hasAll(['cost', 'updatedAt'])
        && data.keys().hasOnly(['cost', 'updatedAt'])
        && (data.cost == null || (data.cost is number && data.cost >= 0 && data.cost <= 100000))
        && data.updatedAt is timestamp;
    }

    function validLegacyCostMigration(productId) {
      let costPath = /databases/$(database)/documents/productCosts/$(productId);
      return isAdmin()
        && 'cost' in resource.data
        && !('cost' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cost', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && existsAfter(costPath)
        && getAfter(costPath).data.cost == resource.data.cost
        && getAfter(costPath).data.updatedAt is timestamp;
    }

    function validProfileAddress(address) {
      return address is map
        && address.keys().hasOnly(['zip', 'street', 'number', 'complement', 'district', 'city', 'state'])
        && (!('zip' in address) || (address.zip is string && address.zip.size() <= 12))
        && (!('street' in address) || (address.street is string && address.street.size() <= 120))
        && (!('number' in address) || (address.number is string && address.number.size() <= 20))
        && (!('complement' in address) || (address.complement is string && address.complement.size() <= 120))
        && (!('district' in address) || (address.district is string && address.district.size() <= 80))
        && (!('city' in address) || (address.city is string && address.city.size() <= 80))
        && (!('state' in address) || (address.state is string && address.state.size() <= 2));
    }

    function validCustomerData(data, uid) {
      return signedIn()
        && request.auth.uid == uid
        && data.keys().hasAll(['uid', 'name', 'email', 'phone', 'address', 'marketingConsent', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'address', 'marketingConsent', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.email == request.auth.token.email
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.email is string && data.email.size() <= 254
        && data.phone is string && data.phone.size() <= 40
        && validProfileAddress(data.address)
        && data.marketingConsent is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validCustomerUpdate(data, uid) {
      return validCustomerData(data, uid)
        && data.uid == resource.data.uid
        && data.email == resource.data.email
        && data.createdAt == resource.data.createdAt;
    }

    function validCategory(data) {
      return data.keys().hasAll(['name', 'active', 'updatedAt'])
        && data.keys().hasOnly(['name', 'active', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.active is bool && data.updatedAt is timestamp;
    }

    function validReservationItem(item) {
      let productPath = /databases/$(database)/documents/products/$(item.productId);
      let product = get(productPath).data;
      return item is map
        && item.keys().hasOnly(['productId', 'name', 'size', 'quantity', 'unitPriceCents'])
        && item.keys().hasAll(['productId', 'name', 'size', 'quantity', 'unitPriceCents'])
        && item.productId is string && item.productId.size() > 0 && item.productId.size() <= 150
        && !item.productId.matches('.*[/].*')
        && item.name is string && item.name.size() > 0 && item.name.size() <= 160
        && item.size is string && item.size.size() > 0 && item.size.size() <= 40
        && item.quantity is int && item.quantity > 0 && item.quantity <= 20
        && item.unitPriceCents is int && item.unitPriceCents > 0
        && exists(productPath)
        && product.active == true
        && product.name == item.name
        && product.sizes.hasAny([item.size])
        && ((('stockBySize' in product)
          && item.size in product.stockBySize
          && item.quantity <= product.stockBySize[item.size])
          || (!('stockBySize' in product)
            && item.size == product.sizes[0]
            && item.quantity <= product.stock))
        && item.unitPriceCents == math.round(
          product.price
          * (100 - (('discount' in product) ? product.discount : 0))
        );
    }

    function validReservationItems(items) {
      return items is list && items.size() > 0 && items.size() <= 6
        && validReservationItem(items[0])
        && (items.size() < 2 || validReservationItem(items[1]))
        && (items.size() < 3 || validReservationItem(items[2]))
        && (items.size() < 4 || validReservationItem(items[3]))
        && (items.size() < 5 || validReservationItem(items[4]))
        && (items.size() < 6 || validReservationItem(items[5]))
        && (items.size() < 2 || items[0].productId != items[1].productId || items[0].size != items[1].size)
        && (items.size() < 3 || items[0].productId != items[2].productId || items[0].size != items[2].size)
        && (items.size() < 3 || items[1].productId != items[2].productId || items[1].size != items[2].size)
        && (items.size() < 4 || items[0].productId != items[3].productId || items[0].size != items[3].size)
        && (items.size() < 4 || items[1].productId != items[3].productId || items[1].size != items[3].size)
        && (items.size() < 4 || items[2].productId != items[3].productId || items[2].size != items[3].size)
        && (items.size() < 5 || items[0].productId != items[4].productId || items[0].size != items[4].size)
        && (items.size() < 5 || items[1].productId != items[4].productId || items[1].size != items[4].size)
        && (items.size() < 5 || items[2].productId != items[4].productId || items[2].size != items[4].size)
        && (items.size() < 5 || items[3].productId != items[4].productId || items[3].size != items[4].size)
        && (items.size() < 6 || items[0].productId != items[5].productId || items[0].size != items[5].size)
        && (items.size() < 6 || items[1].productId != items[5].productId || items[1].size != items[5].size)
        && (items.size() < 6 || items[2].productId != items[5].productId || items[2].size != items[5].size)
        && (items.size() < 6 || items[3].productId != items[5].productId || items[3].size != items[5].size)
        && (items.size() < 6 || items[4].productId != items[5].productId || items[4].size != items[5].size);
    }

    function validReservationTotal(data) {
      let items = data.items;
      let subtotal = (items.size() > 0 ? items[0].quantity * items[0].unitPriceCents : 0)
        + (items.size() > 1 ? items[1].quantity * items[1].unitPriceCents : 0)
        + (items.size() > 2 ? items[2].quantity * items[2].unitPriceCents : 0)
        + (items.size() > 3 ? items[3].quantity * items[3].unitPriceCents : 0)
        + (items.size() > 4 ? items[4].quantity * items[4].unitPriceCents : 0)
        + (items.size() > 5 ? items[5].quantity * items[5].unitPriceCents : 0);
      return data.totalCents is int && data.totalCents == subtotal && data.totalCents > 0;
    }

    function validAddress(data) {
      return data.deliveryMethod == 'Retirada'
        ? data.address is map && data.address.keys().size() == 0
        : data.deliveryMethod == 'Entrega'
          && data.address is map
          && data.address.keys().hasOnly(['zip', 'street', 'number', 'district', 'city', 'state'])
          && data.address.keys().hasAll(['zip', 'street', 'number', 'district', 'city', 'state'])
          && data.address.zip is string && data.address.zip.size() <= 12
          && data.address.street is string && data.address.street.size() > 0 && data.address.street.size() <= 120
          && data.address.number is string && data.address.number.size() > 0 && data.address.number.size() <= 20
          && data.address.district is string && data.address.district.size() > 0 && data.address.district.size() <= 80
          && data.address.city is string && data.address.city.size() > 0 && data.address.city.size() <= 80
          && data.address.state is string && data.address.state.size() == 2;
    }

    function validReservation(data) {
      return signedIn()
        && data.keys().hasAll(['uid', 'confirmationCode', 'customerName', 'phone', 'items', 'totalCents', 'deliveryMethod', 'address', 'pickupDetails', 'notes', 'marketingConsent', 'status', 'statusHistory', 'stockApplied', 'stockRestored', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'confirmationCode', 'customerName', 'phone', 'items', 'totalCents', 'deliveryMethod', 'address', 'pickupDetails', 'notes', 'marketingConsent', 'status', 'statusHistory', 'stockApplied', 'stockRestored', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.confirmationCode is string && data.confirmationCode.size() >= 10 && data.confirmationCode.size() <= 32
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120
        && data.phone is string && data.phone.matches('^[0-9]{10,13}$')
        && validReservationItems(data.items)
        && validReservationTotal(data)
        && validAddress(data)
        && data.pickupDetails is string && data.pickupDetails.size() <= 160
        && data.notes is string && data.notes.size() <= 500
        && data.marketingConsent is bool
        && data.status == 'Aguardando confirmação'
        && data.statusHistory == ['Aguardando confirmação']
        && data.stockApplied == false && data.stockRestored == false
        && validSalesMetadata(data)
        && data.createdAt is timestamp && data.createdAt == request.time
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function validStatusHistory(history) {
      return history is list && history.size() >= 1 && history.size() <= 7
        && history[0] == 'Aguardando confirmação'
        && history.toSet().hasOnly(['Aguardando confirmação', 'Reserva confirmada', 'Em preparação', 'Disponível para retirada', 'Em rota de entrega', 'Entregue', 'Concluído', 'Cancelado']);
    }

    function historyPrefixUnchanged(oldHistory, newHistory) {
      return (oldHistory.size() < 1 || newHistory[0] == oldHistory[0])
        && (oldHistory.size() < 2 || newHistory[1] == oldHistory[1])
        && (oldHistory.size() < 3 || newHistory[2] == oldHistory[2])
        && (oldHistory.size() < 4 || newHistory[3] == oldHistory[3])
        && (oldHistory.size() < 5 || newHistory[4] == oldHistory[4])
        && (oldHistory.size() < 6 || newHistory[5] == oldHistory[5]);
    }

    function validSalesMetadata(data) {
      return (data.status == 'Concluído'
          && data.keys().hasAll(['salesChannel', 'paymentMethod', 'saleTotalCents', 'installmentCount', 'installmentValueCents', 'finalInstallmentValueCents', 'closedAt'])
          && data.salesChannel in ['Loja física', 'Instagram', 'WhatsApp', 'Site', 'Outro']
          && data.paymentMethod in ['Pix', 'Cartão de crédito à vista', 'Cartão de crédito parcelado', 'Cartão de débito', 'Dinheiro', 'Transferência']
          && data.saleTotalCents is int && data.saleTotalCents > 0 && data.saleTotalCents <= 100000000
          && data.installmentCount is int && data.installmentCount >= 1 && data.installmentCount <= 12
          && data.installmentValueCents is int && data.installmentValueCents > 0
          && data.finalInstallmentValueCents is int && data.finalInstallmentValueCents > 0
          && data.installmentValueCents * (data.installmentCount - 1) + data.finalInstallmentValueCents == data.saleTotalCents
          && ((data.paymentMethod == 'Cartão de crédito parcelado' && data.installmentCount >= 2)
            || (data.paymentMethod != 'Cartão de crédito parcelado' && data.installmentCount == 1
              && data.installmentValueCents == data.saleTotalCents))
          && data.closedAt is timestamp && data.closedAt == request.time)
        || (data.status != 'Concluído'
          && !('salesChannel' in data) && !('paymentMethod' in data)
          && !('saleTotalCents' in data) && !('installmentCount' in data)
          && !('installmentValueCents' in data) && !('finalInstallmentValueCents' in data)
          && !('closedAt' in data));
    }

    function validAdminReservation(data) {
      return data.keys().hasAll(['uid', 'confirmationCode', 'customerName', 'phone', 'items', 'totalCents', 'deliveryMethod', 'address', 'pickupDetails', 'notes', 'marketingConsent', 'status', 'statusHistory', 'stockApplied', 'stockRestored', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'confirmationCode', 'customerName', 'phone', 'items', 'totalCents', 'subtotalCents', 'discountCents', 'couponCode', 'couponPercent', 'couponReserved', 'couponCounted', 'deliveryMethod', 'address', 'pickupDetails', 'notes', 'marketingConsent', 'status', 'statusHistory', 'stockApplied', 'stockRestored', 'createdAt', 'updatedAt', 'confirmedAt', 'cancelledAt', 'salesChannel', 'paymentMethod', 'saleTotalCents', 'installmentCount', 'installmentValueCents', 'finalInstallmentValueCents', 'closedAt'])
        && data.uid == resource.data.uid
        && data.confirmationCode == resource.data.confirmationCode
        && data.customerName == resource.data.customerName
        && data.phone == resource.data.phone
        && data.items == resource.data.items
        && data.totalCents == resource.data.totalCents
        && (!('couponCode' in resource.data) || data.couponCode == resource.data.couponCode)
        && (!('couponPercent' in resource.data) || data.couponPercent == resource.data.couponPercent)
        && (!('couponReserved' in data) || data.couponReserved is bool)
        && (!('couponCounted' in data) || data.couponCounted is bool)
        && (!('subtotalCents' in resource.data) || data.subtotalCents == resource.data.subtotalCents)
        && (!('discountCents' in resource.data) || data.discountCents == resource.data.discountCents)
        && data.deliveryMethod == resource.data.deliveryMethod
        && data.address == resource.data.address
        && data.pickupDetails == resource.data.pickupDetails
        && data.notes == resource.data.notes
        && data.marketingConsent == resource.data.marketingConsent
        && data.createdAt == resource.data.createdAt
        && data.confirmationCode is string && data.confirmationCode.size() >= 10 && data.confirmationCode.size() <= 32
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 120
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40
        // Item snapshots and totals were checked when the request was created.
        // Rechecking them against today's catalog would block later status changes
        // after stock reaches zero or a product price is edited.
        && data.pickupDetails is string && data.pickupDetails.size() <= 160
        && data.notes is string && data.notes.size() <= 500
        && data.marketingConsent is bool
        && data.status in ['Aguardando confirmação', 'Reserva confirmada', 'Em preparação', 'Disponível para retirada', 'Em rota de entrega', 'Entregue', 'Concluído', 'Cancelado']
        && validStatusHistory(data.statusHistory)
        && validSalesMetadata(data)
        && data.statusHistory.size() == resource.data.statusHistory.size() + 1
        && historyPrefixUnchanged(resource.data.statusHistory, data.statusHistory)
        && data.statusHistory[data.statusHistory.size() - 1] == data.status
        && resource.data.statusHistory[resource.data.statusHistory.size() - 1] == resource.data.status
        && data.stockApplied is bool && data.stockRestored is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('confirmedAt' in data) || data.confirmedAt is timestamp)
        && (!('cancelledAt' in data) || data.cancelledAt is timestamp)
        && (!('confirmedAt' in resource.data) || ('confirmedAt' in data && data.confirmedAt == resource.data.confirmedAt))
        && (!('confirmedAt' in data) || 'confirmedAt' in resource.data || data.status == 'Reserva confirmada')
        && (!('cancelledAt' in resource.data) || ('cancelledAt' in data && data.cancelledAt == resource.data.cancelledAt))
        && (!('cancelledAt' in data) || 'cancelledAt' in resource.data || data.status == 'Cancelado')
        && (resource.data.status != 'Aguardando confirmação' || data.status != 'Reserva confirmada' || 'confirmedAt' in data);
    }

    function validCoupon(data) {
      return data.keys().hasAll(['code', 'value', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'value', 'status', 'maxUses', 'uses', 'reservedUses', 'lastReservationId', 'createdAt', 'updatedAt'])
        && data.code is string && data.code.size() >= 3 && data.code.size() <= 30
        && data.value is int && data.value >= 1 && data.value <= 99
        && (!('maxUses' in data) || (data.maxUses is int && data.maxUses >= 1 && data.maxUses <= 1000000))
        && (!('uses' in data) || (data.uses is int && data.uses >= 0 && data.uses <= 1000000))
        && (!('reservedUses' in data) || (data.reservedUses is int && data.reservedUses >= 0 && data.reservedUses <= 1000000))
        && (!('lastReservationId' in data) || (data.lastReservationId is string && data.lastReservationId.size() >= 10 && data.lastReservationId.size() <= 128))
        && data.status in ['draft', 'published']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function couponLimitUnchanged(oldData, newData) {
      return ((!('maxUses' in oldData) && !('maxUses' in newData))
        || ('maxUses' in oldData && 'maxUses' in newData && oldData.maxUses == newData.maxUses));
    }

    function validAdminCouponUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAdmin()
        && validCoupon(request.resource.data)
        && changed.hasOnly(['status', 'uses', 'reservedUses', 'updatedAt'])
        && request.resource.data.code == resource.data.code
        && request.resource.data.value == resource.data.value
        && couponLimitUnchanged(resource.data, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && ((changed.hasOnly(['status', 'updatedAt'])
            && request.resource.data.status in ['draft', 'published'])
          || (changed.hasAny(['uses', 'reservedUses'])
            && request.resource.data.status == resource.data.status));
    }

    function validCouponReservationUpdate(couponId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let orderId = ('lastReservationId' in request.resource.data ? request.resource.data.lastReservationId : '');
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let orderExists = exists(orderPath);
      let order = orderExists ? get(orderPath).data : {};
      let orderAfterExists = existsAfter(orderPath);
      let orderAfter = orderAfterExists ? getAfter(orderPath).data : {};
      return signedIn() && isActiveVip()
        && resource.data.status == 'published'
        && validCoupon(request.resource.data)
        && changed.hasOnly(['reservedUses', 'lastReservationId', 'updatedAt'])
        && changed.hasAll(['reservedUses', 'lastReservationId'])
        && request.resource.data.code == couponId
        && request.resource.data.code == resource.data.code
        && request.resource.data.value == resource.data.value
        && couponLimitUnchanged(resource.data, request.resource.data)
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && (('uses' in request.resource.data ? request.resource.data.uses : 0)
          == ('uses' in resource.data ? resource.data.uses : 0))
        && request.resource.data.reservedUses
          == (('reservedUses' in resource.data ? resource.data.reservedUses : 0) + 1)
        && (!('maxUses' in request.resource.data)
          || ((('uses' in request.resource.data ? request.resource.data.uses : 0)
            + request.resource.data.reservedUses) <= request.resource.data.maxUses))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastReservationId is string
        && request.resource.data.lastReservationId.size() >= 10
        && request.resource.data.lastReservationId.size() <= 128
        && request.resource.data.lastReservationId.matches('^[A-Za-z0-9_-]+$')
        && orderExists
        && order.uid == request.auth.uid
        && !('couponCode' in order)
        && order.totalCents > 0
        && order.status in ['Aguardando confirmação', 'Reserva confirmada', 'Em preparação', 'Disponível para retirada', 'Em rota de entrega', 'Entregue']
        && orderAfterExists
        && orderAfter.couponCode == couponId
        && orderAfter.couponReserved == true
        && orderAfter.couponCounted == false
        && orderAfter.couponPercent == request.resource.data.value
        && orderAfter.updatedAt == request.time;
    }

    function validOwnerCouponReservation(orderId) {
      let couponCode = ('couponCode' in request.resource.data ? request.resource.data.couponCode : '');
      let couponPath = /databases/$(database)/documents/coupons/$(couponCode);
      let couponExists = existsAfter(couponPath);
      let coupon = couponExists ? getAfter(couponPath).data : {};
      let uses = ('uses' in coupon ? coupon.uses : 0);
      let reserved = ('reservedUses' in coupon ? coupon.reservedUses : 0);
      return signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status in ['Aguardando confirmação', 'Reserva confirmada', 'Em preparação', 'Disponível para retirada', 'Em rota de entrega', 'Entregue']
        && !('couponCode' in resource.data)
        && request.resource.data.couponCode is string
        && request.resource.data.couponCode.matches('^[A-Z0-9_-]{3,30}$')
        && request.resource.data.couponPercent is int
        && request.resource.data.couponPercent >= 1 && request.resource.data.couponPercent <= 99
        && request.resource.data.subtotalCents == resource.data.totalCents
        && request.resource.data.discountCents is int
        && request.resource.data.discountCents == math.round(request.resource.data.subtotalCents * request.resource.data.couponPercent / 100)
        && request.resource.data.totalCents == request.resource.data.subtotalCents - request.resource.data.discountCents
        && request.resource.data.couponReserved == true && request.resource.data.couponCounted == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['couponCode', 'couponPercent', 'subtotalCents', 'discountCents', 'totalCents', 'couponReserved', 'couponCounted', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && couponExists
        && coupon.code == request.resource.data.couponCode && coupon.status == 'published'
        && coupon.value == request.resource.data.couponPercent
        && coupon.lastReservationId == orderId
        && reserved >= 1
        && (!('maxUses' in coupon) || uses + reserved <= coupon.maxUses);
    }

    function validCampaign(data) {
      return data.keys().hasAll(['title', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() > 0 && data.description.size() <= 500
        && data.status in ['draft', 'published']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validVipMember(data, uid) {
      return data.keys().hasAll(['uid', 'name', 'email', 'phone', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'status', 'createdAt', 'updatedAt'])
        && data.uid == uid && data.uid is string && data.uid.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.email is string && data.email.size() <= 254
        && data.phone is string && data.phone.size() <= 40
        && data.status in ['active', 'blocked', 'removed']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function hasCustomerProfile(uid) {
      return exists(/databases/$(database)/documents/customers/$(uid));
    }

    function isVerifiedVipMember(uid) {
      return signedIn()
        && request.auth.uid == uid
        && hasCustomerProfile(uid)
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isActiveVip() {
      // E-mail verificado e ficha de cliente liberam o VIP automaticamente.
      // Um status não ativo definido pelo admin continua revogando o acesso.
      return signedIn()
        && hasCustomerProfile(request.auth.uid)
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (!exists(/databases/$(database)/documents/vipUsers/$(request.auth.uid))
          || get(/databases/$(database)/documents/vipUsers/$(request.auth.uid)).data.status == 'active');
    }

    function validVipSetting(data) {
      return data.keys().hasAll(['inviteUrl', 'updatedAt'])
        && data.keys().hasOnly(['inviteUrl', 'updatedAt'])
        && data.inviteUrl is string && data.inviteUrl.size() <= 512
        && (data.inviteUrl == '' || data.inviteUrl.matches('^https://chat\\.whatsapp\\.com/[A-Za-z0-9]+$'))
        && data.updatedAt is timestamp;
    }

    function validFinanceBaseline(data) {
      return data.keys().hasAll(['baselineAt', 'resetBy', 'updatedAt'])
        && data.keys().hasOnly(['baselineAt', 'resetBy', 'updatedAt'])
        && data.baselineAt is timestamp && data.baselineAt == request.time
        && data.resetBy == request.auth.uid
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function validMessageData(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.email is string && data.email.size() > 3 && data.email.size() <= 254
        && data.email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$')
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 100
        && data.message is string && data.message.size() >= 8 && data.message.size() <= 1500
        && data.status in ['Nova', 'Em atendimento', 'Concluída']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validMessage(data, messageId) {
      return signedIn() && validMessageData(data)
        && data.uid == request.auth.uid && data.status == 'Nova'
        && data.createdAt == request.time && data.updatedAt == request.time
        && messageCooldownWritten(messageId, data.email);
    }

    function validCommunityComment(data) {
      return data.keys().hasAll(['uid', 'name', 'text', 'status', 'createdAt'])
        && data.keys().hasOnly(['uid', 'name', 'text', 'status', 'createdAt'])
        && data.uid == request.auth.uid && data.uid is string && data.uid.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.text is string && data.text.size() >= 8 && data.text.size() <= 500
        && data.status == 'published'
        && data.createdAt is timestamp && data.createdAt == request.time;
    }

    function validReservationLimit(data, phone) {
      return data.keys().hasAll(['phone', 'lastOrderId', 'lastSubmittedAt'])
        && data.keys().hasOnly(['phone', 'lastOrderId', 'lastSubmittedAt'])
        && data.phone == phone && phone.matches('^[0-9]{10,13}$')
        && data.lastOrderId is string && data.lastOrderId.size() >= 10 && data.lastOrderId.size() <= 128
        && data.lastSubmittedAt is timestamp
        && data.lastSubmittedAt == request.time;
    }

    function reservationCooldownWritten(orderId, phone) {
      let path = /databases/$(database)/documents/reservationLimits/$(phone);
      return signedIn() && existsAfter(path)
        && getAfter(path).data.phone == phone
        && getAfter(path).data.lastOrderId == orderId
        && getAfter(path).data.lastSubmittedAt == request.time;
    }

    function reservationOrderWritten(phone, orderId) {
      let path = /databases/$(database)/documents/orders/$(orderId);
      return existsAfter(path)
        && getAfter(path).data.uid == request.auth.uid
        && getAfter(path).data.phone == phone;
    }

    function validMessageLimit(data, email) {
      return data.keys().hasAll(['email', 'lastMessageId', 'lastSubmittedAt'])
        && data.keys().hasOnly(['email', 'lastMessageId', 'lastSubmittedAt'])
        && data.email == email && email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$')
        && data.lastMessageId is string && data.lastMessageId.size() >= 10 && data.lastMessageId.size() <= 128
        && data.lastSubmittedAt is timestamp && data.lastSubmittedAt == request.time;
    }

    function messageCooldownWritten(messageId, email) {
      let path = /databases/$(database)/documents/messageLimits/$(email);
      return signedIn() && existsAfter(path)
        && getAfter(path).data.email == email
        && getAfter(path).data.lastMessageId == messageId
        && getAfter(path).data.lastSubmittedAt == request.time;
    }

    function messageWritten(email, messageId) {
      let path = /databases/$(database)/documents/messages/$(messageId);
      return existsAfter(path)
        && getAfter(path).data.uid == request.auth.uid
        && getAfter(path).data.email == email;
    }

    function validStockAdjustment() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'stockBySize', 'updatedAt'])
        && request.resource.data.stock is int && request.resource.data.stock >= 0 && request.resource.data.stock <= 100000
        && validStockBySize(request.resource.data)
        && request.resource.data.updatedAt is timestamp
        && (!('cost' in resource.data) || request.resource.data.cost == resource.data.cost);
    }

    function validTransition() {
      return (resource.data.status == 'Aguardando confirmação'
          && request.resource.data.status in ['Reserva confirmada', 'Cancelado'])
        || (resource.data.status == 'Reserva confirmada'
          && request.resource.data.status in ['Em preparação', 'Cancelado'])
        || (resource.data.status == 'Em preparação'
          && request.resource.data.status in ['Disponível para retirada', 'Em rota de entrega', 'Cancelado'])
        || (resource.data.status == 'Disponível para retirada'
          && request.resource.data.status in ['Entregue', 'Cancelado'])
        || (resource.data.status == 'Em rota de entrega'
          && request.resource.data.status in ['Entregue', 'Cancelado'])
        || (resource.data.status == 'Entregue'
          && request.resource.data.status == 'Concluído');
    }

    function validStockTransition() {
      return (request.resource.data.status == 'Reserva confirmada'
          && request.resource.data.stockApplied == true
          && request.resource.data.stockRestored == false)
        || (request.resource.data.status == 'Cancelado'
          && resource.data.stockApplied == true
          && resource.data.stockRestored == false
          && request.resource.data.stockApplied == false
          && request.resource.data.stockRestored == true)
        || (request.resource.data.status == 'Cancelado'
          && resource.data.stockApplied == false
          && request.resource.data.stockApplied == false
          && request.resource.data.stockRestored == resource.data.stockRestored)
        || (request.resource.data.status in ['Em preparação', 'Disponível para retirada', 'Em rota de entrega', 'Entregue', 'Concluído']
          && request.resource.data.stockApplied == resource.data.stockApplied
          && request.resource.data.stockRestored == resource.data.stockRestored);
    }

    // A autorização é administrada somente pelo Console/SDK Admin. O titular
    // pode consultar o próprio documento, mas nunca conceder acesso a si.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /customers/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if validCustomerData(request.resource.data, uid);
      allow update: if signedIn() && request.auth.uid == uid
        && validCustomerUpdate(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'marketingConsent', 'updatedAt']);
      // Keep the customer profile and VIP row linked. If a VIP row exists,
      // both records must be deleted in the same admin batch.
      allow delete: if isAdmin()
        && !existsAfter(/databases/$(database)/documents/vipUsers/$(uid));
    }

    match /products/{productId} {
      // A loja pública lê somente o catálogo publicado. Administradores
      // autorizados podem consultar também os produtos inativos.
      // Older catalog entries may still contain a public `cost` field. Hide
      // them from customers until an admin completes the private-cost migration.
      allow get, list: if isAdmin() || (resource.data.active == true && !('cost' in resource.data));
      allow create: if isAdmin() && validProduct(request.resource.data);
      allow update: if validStockAdjustment()
        || (isAdmin() && validProduct(request.resource.data)
        && (('createdAt' in resource.data)
          ? request.resource.data.createdAt == resource.data.createdAt
          : !('createdAt' in request.resource.data)))
        || validLegacyCostMigration(productId);
      allow delete: if isAdmin();
    }

    match /productCosts/{productId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() && validProductCost(request.resource.data);
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if isAdmin() || resource.data.active == true;
      allow create, update: if isAdmin() && validCategory(request.resource.data);
      allow delete: if siteResetAuthorized();
    }

    match /orders/{orderId} {
      // O checkout gera primeiro um ID aleatório e consulta esse documento
      // para tornar uma tentativa repetida idempotente. Permitir somente o
      // get de documentos ausentes não expõe pedidos existentes de terceiros.
      allow get: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // Requests are paired atomically with a 30-second limiter keyed by the
      // normalized WhatsApp number. The same phone cannot bypass the limit by
      // starting another anonymous Firebase session.
      allow create: if validReservation(request.resource.data)
        && reservationCooldownWritten(orderId, request.resource.data.phone);
      allow update: if (isAdmin()
          && validAdminReservation(request.resource.data)
          && validTransition()
          && validStockTransition()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusHistory', 'updatedAt', 'stockApplied', 'stockRestored', 'confirmedAt', 'cancelledAt', 'salesChannel', 'paymentMethod', 'saleTotalCents', 'installmentCount', 'installmentValueCents', 'finalInstallmentValueCents', 'closedAt', 'couponReserved', 'couponCounted'])
          && request.resource.data.updatedAt is timestamp)
        || validOwnerCouponReservation(orderId);
      allow delete: if siteResetAuthorized();
    }

    match /reservationLimits/{uid} {
      allow get, list: if isAdmin();
      allow delete: if siteResetAuthorized();
      allow create: if signedIn()
        && validReservationLimit(request.resource.data, uid)
        && reservationOrderWritten(uid, request.resource.data.lastOrderId);
      allow update: if signedIn()
        && validReservationLimit(request.resource.data, uid)
        && resource.data.phone == uid
        && request.time >= resource.data.lastSubmittedAt + duration.value(30, 's')
        && reservationOrderWritten(uid, request.resource.data.lastOrderId);
    }

    match /coupons/{couponId} {
      allow get: if isAdmin() || resource == null || (isActiveVip() && resource.data.status == 'published');
      allow list: if isAdmin() || (isActiveVip() && resource.data.status == 'published');
      allow create: if isAdmin() && validCoupon(request.resource.data);
      allow update: if validAdminCouponUpdate()
        || validCouponReservationUpdate(couponId);
      allow delete: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow get, list: if isAdmin() || (isActiveVip() && resource.data.status == 'published');
      allow create: if isAdmin() && validCampaign(request.resource.data);
      allow update: if isAdmin()
        && validCampaign(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow get, list: if isAdmin();
      // The email-keyed limiter applies across anonymous sessions and is
      // committed in the same atomic batch as the contact message.
      allow create: if validMessage(request.resource.data, messageId);
      allow update: if isAdmin()
        && validMessageData(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && request.resource.data.subject == resource.data.subject
        && request.resource.data.message == resource.data.message
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['Nova', 'Em atendimento', 'Concluída']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow get, list: if isAdmin() || resource.data.status == 'published';
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && validCommunityComment(request.resource.data);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /messageLimits/{uid} {
      allow get, list: if isAdmin();
      allow delete: if siteResetAuthorized();
      allow create: if signedIn()
        && validMessageLimit(request.resource.data, uid)
        && messageWritten(uid, request.resource.data.lastMessageId);
      allow update: if signedIn()
        && validMessageLimit(request.resource.data, uid)
        && resource.data.email == uid
        && request.time >= resource.data.lastSubmittedAt + duration.value(30, 's')
        && messageWritten(uid, request.resource.data.lastMessageId);
    }

    match /settings/{settingId} {
      allow get: if (settingId == 'vip' && (isAdmin() || isActiveVip()))
        || (settingId in ['finance', 'siteReset'] && isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() && ((settingId == 'vip' && validVipSetting(request.resource.data))
        || (settingId == 'finance' && validFinanceBaseline(request.resource.data))
        || (settingId == 'siteReset' && !exists(/databases/$(database)/documents/settings/siteReset)
          && validSiteResetMarker(request.resource.data)));
      allow update: if isAdmin() && ((settingId == 'vip' && validVipSetting(request.resource.data))
        || (settingId == 'finance' && validFinanceBaseline(request.resource.data))
        || (settingId == 'siteReset' && validSiteResetMarker(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resetBy', 'createdAt'])));
      allow delete: if siteResetAuthorized();
    }

    match /vipUsers/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      // A confirmed e-mail can create its own active membership record. Admins
      // retain the ability to manage explicit blocks and manual records.
      allow create: if hasCustomerProfile(uid)
        && validVipMember(request.resource.data, uid)
        && (isAdmin()
          || (isVerifiedVipMember(uid)
            && request.resource.data.status == 'active'
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time));
      allow update: if isAdmin()
        && hasCustomerProfile(uid)
        && validVipMember(request.resource.data, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.name == resource.data.name
        && request.resource.data.email == resource.data.email
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.createdAt == resource.data.createdAt;
      // Normally, remove a VIP record only with its customer profile. The
      // protected site reset can clear VIP enrollment while keeping customers.
      allow delete: if isAdmin()
        && (!existsAfter(/databases/$(database)/documents/customers/$(uid))
          || siteResetAuthorized());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

